[
  {
    "name": "returns an empty string for an empty word",
    "input": "",
    "expected": ""
  },
  {
    "name": "adds ay to words starting with a vowel",
    "input": "apple",
    "expected": "appleay"
  },
  {
    "name": "adds ay to words starting with a vowel",
    "input": "extra",
    "expected": "extraay"
  },
  {
    "name": "adds ay to words starting with a vowel",
    "input": "igloo",
    "expected": "iglooay"
  },
  {
    "name": "adds ay to words starting with a vowel",
    "input": "orange",
    "expected": "orangeay"
  },
  {
    "name": "adds ay to words starting with a vowel",
    "input": "under",
    "expected": "underay"
  },
  {
    "name": "moves the first consonant to the end and adds ay",
    "input": "hello",
    "expected": "ellohay"
  },
  {
    "name": "translates each word in a phrase",
    "input": "hello world",
    "expected": "ellohay orldway"
  },
  {
    "name": "preserves capitalization when translating a phrase",
    "input": "Hello Exciting world",
    "expected": "Ellohay Excitingay orldway"
  },
  {
    "name": "keeps a comma after the translated word",
    "input": "hello, exciting world",
    "expected": "ellohay, excitingay orldway"
  },
  {
    "name": "preserves exclamation marks, commas, and capitalization",
    "input": "hello! exciting, World",
    "expected": "ellohay! excitingay, Orldway"
  },
  {
    "name": "preserves leading, trailing, and repeated spaces",
    "input": "  hello!   exciting,     World    ",
    "expected": "  ellohay!   excitingay,     Orldway    "
  },
  {
    "name": "keeps a question mark after the translated word",
    "input": "hello?",
    "expected": "ellohay?"
  },
  {
    "name": "keeps repeated exclamation marks after the translated word",
    "input": "hello!!",
    "expected": "ellohay!!"
  },
  {
    "name": "preserves tabs and newlines between words",
    "input": "\thello!\t\texciting,\n\nWorld\n",
    "expected": "\tellohay!\t\texcitingay,\n\nOrldway\n"
  },
  {
    "name": "moves the initial consonant cluster to the end",
    "input": "three",
    "expected": "eethray"
  },
  {
    "name": "preserves surrounding double quotes",
    "input": "\"hello?\"",
    "expected": "\"ellohay?\""
  },
  {
    "name": "keeps all-uppercase words uppercase, including the suffix",
    "input": "\"HELLO! EXTRA THREE\"",
    "expected": "\"ELLOHAY! EXTRAAY EETHRAY\""
  },
  {
    "name": "moves qu together as part of the initial consonant cluster",
    "input": "queen squeal",
    "expected": "eenquay ealsquay"
  },
  {
    "name": "leaves numbers unchanged",
    "input": "hello 123",
    "expected": "ellohay 123"
  },
  {
    "name": "punctuation separates adjacent words",
    "input": "hello,world",
    "expected": "ellohay,orldway"
  },
  {
    "name": "punctuation keeps its position between digits",
    "input": "1,2",
    "expected": "1,2"
  },
  {
    "name": "a prefix does not cross punctuation",
    "input": "q!ueen",
    "expected": "qay!ueenay"
  },
  {
    "name": "quotes separate adjacent words",
    "input": "\"hello\"\"World\"",
    "expected": "\"ellohay\"\"Orldway\""
  },
  {
    "name": "uppercase qu with quotes and repeated punctuation",
    "input": "\"QUEEN?!\"",
    "expected": "\"EENQUAY?!\""
  },
  {
    "name": "title-case qu with punctuation",
    "input": "Queen!!",
    "expected": "Eenquay!!"
  },
  {
    "name": "title-case cluster inside quotes",
    "input": "\"Three?\"",
    "expected": "\"Eethray?\""
  },
  {
    "name": "uppercase vowel with quotes and punctuation",
    "input": "\"EXTRA!!\"",
    "expected": "\"EXTRAAY!!\""
  },
  {
    "name": "quoted numbers with punctuation and leading zeros",
    "input": "\"00123?!\"",
    "expected": "\"00123?!\""
  },
  {
    "name": "quotes around a phrase with mixed separators",
    "input": "  \"Hello\tQUEEN!!\nexciting, world?\"  ",
    "expected": "  \"Ellohay\tEENQUAY!!\nexcitingay, orldway?\"  "
  },
  {
    "name": "clusters and numbers across tabs and newlines",
    "input": "\t\"Three QUEENS!!\"\t123,\n\"Exciting squeals?\"\n",
    "expected": "\t\"Eethray EENSQUAY!!\"\t123,\n\"Excitingay ealssquay?\"\n"
  },
  {
    "name": "uppercase and title-case words without an aeiou vowel",
    "input": "\"BRR!!\" Brr?",
    "expected": "\"BRRAY!!\" Brray?"
  },
