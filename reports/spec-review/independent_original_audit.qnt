module independent_original_audit {
 import translate_original.* from "../../translate-original"
 run exact01Test = assert(translate(List()) == List())
 run exact02Test = assert(translate(List("a","p","p","l","e")) == List("a","p","p","l","e","a","y"))
 run exact03Test = assert(translate(List("e","x","t","r","a")) == List("e","x","t","r","a","a","y"))
 run exact04Test = assert(translate(List("i","g","l","o","o")) == List("i","g","l","o","o","a","y"))
 run exact05Test = assert(translate(List("o","r","a","n","g","e")) == List("o","r","a","n","g","e","a","y"))
 run exact06Test = assert(translate(List("u","n","d","e","r")) == List("u","n","d","e","r","a","y"))
 run exact07Test = assert(translate(List("h","e","l","l","o")) == List("e","l","l","o","h","a","y"))
 run exact08Test = assert(translate(List("h","e","l","l","o"," ","w","o","r","l","d")) == List("e","l","l","o","h","a","y"," ","o","r","l","d","w","a","y"))
 run exact09Test = assert(translate(List("H","e","l","l","o"," ","E","x","c","i","t","i","n","g"," ","w","o","r","l","d")) == List("E","l","l","o","h","a","y"," ","E","x","c","i","t","i","n","g","a","y"," ","o","r","l","d","w","a","y"))
 run exact10Test = assert(translate(List("h","e","l","l","o",","," ","e","x","c","i","t","i","n","g"," ","w","o","r","l","d")) == List("e","l","l","o","h","a","y",","," ","e","x","c","i","t","i","n","g","a","y"," ","o","r","l","d","w","a","y"))
 run exact11Test = assert(translate(List("h","e","l","l","o","!"," ","e","x","c","i","t","i","n","g",","," ","W","o","r","l","d")) == List("e","l","l","o","h","a","y","!"," ","e","x","c","i","t","i","n","g","a","y",","," ","O","r","l","d","w","a","y"))
 run exact12Test = assert(translate(List(" "," ","h","e","l","l","o","!"," "," "," ","e","x","c","i","t","i","n","g",","," "," "," "," "," ","W","o","r","l","d"," "," "," "," ")) == List(" "," ","e","l","l","o","h","a","y","!"," "," "," ","e","x","c","i","t","i","n","g","a","y",","," "," "," "," "," ","O","r","l","d","w","a","y"," "," "," "," "))
 run exact13Test = assert(translate(List("h","e","l","l","o","?")) == List("e","l","l","o","h","a","y","?"))
 run exact14Test = assert(translate(List("h","e","l","l","o","!","!")) == List("e","l","l","o","h","a","y","!","!"))
 run exact15Test = assert(translate(List("TAB","h","e","l","l","o","!","TAB","TAB","e","x","c","i","t","i","n","g",",","LF","LF","W","o","r","l","d","LF")) == List("TAB","e","l","l","o","h","a","y","!","TAB","TAB","e","x","c","i","t","i","n","g","a","y",",","LF","LF","O","r","l","d","w","a","y","LF"))
 run exact16Test = assert(translate(List("t","h","r","e","e")) == List("e","e","t","h","r","a","y"))
 run exact17Test = assert(translate(List("QUOTE","h","e","l","l","o","?","QUOTE")) == List("QUOTE","e","l","l","o","h","a","y","?","QUOTE"))
 run exact18Test = assert(translate(List("QUOTE","H","E","L","L","O","!"," ","E","X","T","R","A"," ","T","H","R","E","E","QUOTE")) == List("QUOTE","E","L","L","O","H","A","Y","!"," ","E","X","T","R","A","A","Y"," ","E","E","T","H","R","A","Y","QUOTE"))
 run exact19Test = assert(translate(List("q","u","e","e","n"," ","s","q","u","e","a","l")) == List("e","e","n","q","u","a","y"," ","e","a","l","s","q","u","a","y"))
 run exact20Test = assert(translate(List("h","e","l","l","o"," ","1","2","3")) == List("e","l","l","o","h","a","y"," ","1","2","3"))
 run exact21Test = assert(translate(List("h","e","l","l","o",",","w","o","r","l","d")) == List("e","l","l","o","h","a","y",",","o","r","l","d","w","a","y"))
 run exact22Test = assert(translate(List("1",",","2")) == List("1",",","2"))
 run exact23Test = assert(translate(List("q","!","u","e","e","n")) == List("q","a","y","!","u","e","e","n","a","y"))
 run exact24Test = assert(translate(List("QUOTE","h","e","l","l","o","QUOTE","QUOTE","W","o","r","l","d","QUOTE")) == List("QUOTE","e","l","l","o","h","a","y","QUOTE","QUOTE","O","r","l","d","w","a","y","QUOTE"))
 run exact25Test = assert(translate(List("QUOTE","Q","U","E","E","N","?","!","QUOTE")) == List("QUOTE","E","E","N","Q","U","A","Y","?","!","QUOTE"))
 run exact26Test = assert(translate(List("Q","u","e","e","n","!","!")) == List("E","e","n","q","u","a","y","!","!"))
 run exact27Test = assert(translate(List("QUOTE","T","h","r","e","e","?","QUOTE")) == List("QUOTE","E","e","t","h","r","a","y","?","QUOTE"))
 run exact28Test = assert(translate(List("QUOTE","E","X","T","R","A","!","!","QUOTE")) == List("QUOTE","E","X","T","R","A","A","Y","!","!","QUOTE"))
 run exact29Test = assert(translate(List("QUOTE","0","0","1","2","3","?","!","QUOTE")) == List("QUOTE","0","0","1","2","3","?","!","QUOTE"))
 run exact30Test = assert(translate(List(" "," ","QUOTE","H","e","l","l","o","TAB","Q","U","E","E","N","!","!","LF","e","x","c","i","t","i","n","g",","," ","w","o","r","l","d","?","QUOTE"," "," ")) == List(" "," ","QUOTE","E","l","l","o","h","a","y","TAB","E","E","N","Q","U","A","Y","!","!","LF","e","x","c","i","t","i","n","g","a","y",","," ","o","r","l","d","w","a","y","?","QUOTE"," "," "))
 run exact31Test = assert(translate(List("TAB","QUOTE","T","h","r","e","e"," ","Q","U","E","E","N","S","!","!","QUOTE","TAB","1","2","3",",","LF","QUOTE","E","x","c","i","t","i","n","g"," ","s","q","u","e","a","l","s","?","QUOTE","LF")) == List("TAB","QUOTE","E","e","t","h","r","a","y"," ","E","E","N","S","Q","U","A","Y","!","!","QUOTE","TAB","1","2","3",",","LF","QUOTE","E","x","c","i","t","i","n","g","a","y"," ","e","a","l","s","s","q","u","a","y","?","QUOTE","LF"))
 run exact32Test = assert(translate(List("QUOTE","B","R","R","!","!","QUOTE"," ","B","r","r","?")) == List("QUOTE","B","R","R","A","Y","!","!","QUOTE"," ","B","r","r","a","y","?"))
 run unsupportedStillTranslatedTest = assert(translate(List("1","a")).length() > 0)
}
