module translate_contract_scenarios {
  import translate_contract.* from "./translate-contract"
  import translate_contract_harness.* from "./translate-contract_harness"
  run fullContractTest = init
    .then(textRequest(List())).expect(observation.permitted == Set(Translated(List())))
    .then(textRequest(List(97, 112, 112, 108, 101))).expect(observation.permitted == Set(Translated(List(97, 112, 112, 108, 101, 97, 121))))
    .then(textRequest(List(101, 120, 116, 114, 97))).expect(observation.permitted == Set(Translated(List(101, 120, 116, 114, 97, 97, 121))))
