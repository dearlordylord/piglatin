    .then(textRequest(List(104, 101, 108, 108, 111))).expect(observation.permitted == Set(Translated(List(101, 108, 108, 111, 104, 97, 121))))
    .then(textRequest(List(104, 101, 108, 108, 111, 32, 119, 111, 114, 108, 100))).expect(observation.permitted == Set(Translated(List(101, 108, 108, 111, 104, 97, 121, 32, 111, 114, 108, 100, 119, 97, 121))))
    .then(textRequest(List(72, 101, 108, 108, 111, 32, 69, 120, 99, 105, 116, 105, 110, 103, 32, 119, 111, 114, 108, 100))).expect(observation.permitted == Set(Translated(List(69, 108, 108, 111, 104, 97, 121, 32, 69, 120, 99, 105, 116, 105, 110, 103, 97, 121, 32, 111, 114, 108, 100, 119, 97, 121))))
    .then(textRequest(List(104, 101, 108, 108, 111, 44, 32, 101, 120, 99, 105, 116, 105, 110, 103, 32, 119, 111, 114, 108, 100))).expect(observation.permitted == Set(Translated(List(101, 108, 108, 111, 104, 97, 121, 44, 32, 101, 120, 99, 105, 116, 105, 110, 103, 97, 121, 32, 111, 114, 108, 100, 119, 97, 121))))
    .then(textRequest(List(104, 101, 108, 108, 111, 33, 32, 101, 120, 99, 105, 116, 105, 110, 103, 44, 32, 87, 111, 114, 108, 100))).expect(observation.permitted == Set(Translated(List(101, 108, 108, 111, 104, 97, 121, 33, 32, 101, 120, 99, 105, 116, 105, 110, 103, 97, 121, 44, 32, 79, 114, 108, 100, 119, 97, 121))))
    .then(textRequest(List(32, 32, 104, 101, 108, 108, 111, 33, 32, 32, 32, 101, 120, 99, 105, 116, 105, 110, 103, 44, 32, 32, 32, 32, 32, 87, 111, 114, 108, 100, 32, 32, 32, 32))).expect(observation.permitted == Set(Translated(List(32, 32, 101, 108, 108, 111, 104, 97, 121, 33, 32, 32, 32, 101, 120, 99, 105, 116, 105, 110, 103, 97, 121, 44, 32, 32, 32, 32, 32, 79, 114, 108, 100, 119, 97, 121, 32, 32, 32, 32))))
    .then(textRequest(List(104, 101, 108, 108, 111, 63))).expect(observation.permitted == Set(Translated(List(101, 108, 108, 111, 104, 97, 121, 63))))
    .then(textRequest(List(104, 101, 108, 108, 111, 33, 33))).expect(observation.permitted == Set(Translated(List(101, 108, 108, 111, 104, 97, 121, 33, 33))))
    .then(textRequest(List(9, 104, 101, 108, 108, 111, 33, 9, 9, 101, 120, 99, 105, 116, 105, 110, 103, 44, 10, 10, 87, 111, 114, 108, 100, 10))).expect(observation.permitted == Set(Translated(List(9, 101, 108, 108, 111, 104, 97, 121, 33, 9, 9, 101, 120, 99, 105, 116, 105, 110, 103, 97, 121, 44, 10, 10, 79, 114, 108, 100, 119, 97, 121, 10))))
    .then(textRequest(List(116, 104, 114, 101, 101))).expect(observation.permitted == Set(Translated(List(101, 101, 116, 104, 114, 97, 121))))
    .then(textRequest(List(34, 104, 101, 108, 108, 111, 63, 34))).expect(observation.permitted == Set(Translated(List(34, 101, 108, 108, 111, 104, 97, 121, 63, 34))))
    .then(textRequest(List(34, 72, 69, 76, 76, 79, 33, 32, 69, 88, 84, 82, 65, 32, 84, 72, 82, 69, 69, 34))).expect(observation.permitted == Set(Translated(List(34, 69, 76, 76, 79, 72, 65, 89, 33, 32, 69, 88, 84, 82, 65, 65, 89, 32, 69, 69, 84, 72, 82, 65, 89, 34))))
    .then(textRequest(List(113, 117, 101, 101, 110, 32, 115, 113, 117, 101, 97, 108))).expect(observation.permitted == Set(Translated(List(101, 101, 110, 113, 117, 97, 121, 32, 101, 97, 108, 115, 113, 117, 97, 121))))
