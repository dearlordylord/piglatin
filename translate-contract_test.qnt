module translate_contract_test {
  import translate_contract.* from "./translate-contract"
  run nonTextTest = assert(outcomes(NonText) == Set(Rejected(NotAString)))
  run helloTest = assert(outcomes(TextInput(List(104, 101, 108, 108, 111))) == Set(Translated(List(101, 108, 108, 111, 104, 97, 121))))
  run mixedTokenRejectedTest = assert(outcomes(TextInput(List(49, 97))) == Set(Rejected(BadToken({ token: List(49, 97), reason: MixedLettersDigits }))))
  run punctuationRejectedTest = assert(outcomes(TextInput(List(59))) == Set(Rejected(BadCharacter({ index: 0, code: 59 }))))
  run caseRejectedTest = assert(outcomes(TextInput(List(65))) == Set(Rejected(BadToken({ token: List(65), reason: UnsupportedCase }))))
  run yRejectedTest = assert(outcomes(TextInput(List(114, 104, 121, 116, 104, 109))) == Set(Rejected(BadToken({ token: List(114, 104, 121, 116, 104, 109), reason: UndefinedY }))))
  run qRejectedTest = assert(outcomes(TextInput(List(113, 104, 97, 116))) == Set(Rejected(BadToken({ token: List(113, 104, 97, 116), reason: UnsupportedQ }))))
  run unrotatedWordRejectedTest = assert(not(wordConforms(List(104, 101, 108, 108, 111), List(104, 101, 108, 108, 111, 97, 121))))
  run case01Test = assert(outcomes(TextInput(List())) == Set(Translated(List())))
  run case02Test = assert(outcomes(TextInput(List(97, 112, 112, 108, 101))) == Set(Translated(List(97, 112, 112, 108, 101, 97, 121))))
  run case03Test = assert(outcomes(TextInput(List(101, 120, 116, 114, 97))) == Set(Translated(List(101, 120, 116, 114, 97, 97, 121))))
  run case04Test = assert(outcomes(TextInput(List(105, 103, 108, 111, 111))) == Set(Translated(List(105, 103, 108, 111, 111, 97, 121))))
  run case05Test = assert(outcomes(TextInput(List(111, 114, 97, 110, 103, 101))) == Set(Translated(List(111, 114, 97, 110, 103, 101, 97, 121))))
  run case06Test = assert(outcomes(TextInput(List(117, 110, 100, 101, 114))) == Set(Translated(List(117, 110, 100, 101, 114, 97, 121))))
  run case07Test = assert(outcomes(TextInput(List(104, 101, 108, 108, 111))) == Set(Translated(List(101, 108, 108, 111, 104, 97, 121))))
  run case08Test = assert(outcomes(TextInput(List(104, 101, 108, 108, 111, 32, 119, 111, 114, 108, 100))) == Set(Translated(List(101, 108, 108, 111, 104, 97, 121, 32, 111, 114, 108, 100, 119, 97, 121))))
  run case09Test = assert(outcomes(TextInput(List(72, 101, 108, 108, 111, 32, 69, 120, 99, 105, 116, 105, 110, 103, 32, 119, 111, 114, 108, 100))) == Set(Translated(List(69, 108, 108, 111, 104, 97, 121, 32, 69, 120, 99, 105, 116, 105, 110, 103, 97, 121, 32, 111, 114, 108, 100, 119, 97, 121))))
  run case10Test = assert(outcomes(TextInput(List(104, 101, 108, 108, 111, 44, 32, 101, 120, 99, 105, 116, 105, 110, 103, 32, 119, 111, 114, 108, 100))) == Set(Translated(List(101, 108, 108, 111, 104, 97, 121, 44, 32, 101, 120, 99, 105, 116, 105, 110, 103, 97, 121, 32, 111, 114, 108, 100, 119, 97, 121))))
  run case11Test = assert(outcomes(TextInput(List(104, 101, 108, 108, 111, 33, 32, 101, 120, 99, 105, 116, 105, 110, 103, 44, 32, 87, 111, 114, 108, 100))) == Set(Translated(List(101, 108, 108, 111, 104, 97, 121, 33, 32, 101, 120, 99, 105, 116, 105, 110, 103, 97, 121, 44, 32, 79, 114, 108, 100, 119, 97, 121))))
  run case12Test = assert(outcomes(TextInput(List(32, 32, 104, 101, 108, 108, 111, 33, 32, 32, 32, 101, 120, 99, 105, 116, 105, 110, 103, 44, 32, 32, 32, 32, 32, 87, 111, 114, 108, 100, 32, 32, 32, 32))) == Set(Translated(List(32, 32, 101, 108, 108, 111, 104, 97, 121, 33, 32, 32, 32, 101, 120, 99, 105, 116, 105, 110, 103, 97, 121, 44, 32, 32, 32, 32, 32, 79, 114, 108, 100, 119, 97, 121, 32, 32, 32, 32))))
  run case13Test = assert(outcomes(TextInput(List(104, 101, 108, 108, 111, 63))) == Set(Translated(List(101, 108, 108, 111, 104, 97, 121, 63))))
  run case14Test = assert(outcomes(TextInput(List(104, 101, 108, 108, 111, 33, 33))) == Set(Translated(List(101, 108, 108, 111, 104, 97, 121, 33, 33))))
  run case15Test = assert(outcomes(TextInput(List(9, 104, 101, 108, 108, 111, 33, 9, 9, 101, 120, 99, 105, 116, 105, 110, 103, 44, 10, 10, 87, 111, 114, 108, 100, 10))) == Set(Translated(List(9, 101, 108, 108, 111, 104, 97, 121, 33, 9, 9, 101, 120, 99, 105, 116, 105, 110, 103, 97, 121, 44, 10, 10, 79, 114, 108, 100, 119, 97, 121, 10))))
  run case16Test = assert(outcomes(TextInput(List(116, 104, 114, 101, 101))) == Set(Translated(List(101, 101, 116, 104, 114, 97, 121))))
  run case17Test = assert(outcomes(TextInput(List(34, 104, 101, 108, 108, 111, 63, 34))) == Set(Translated(List(34, 101, 108, 108, 111, 104, 97, 121, 63, 34))))
  run case18Test = assert(outcomes(TextInput(List(34, 72, 69, 76, 76, 79, 33, 32, 69, 88, 84, 82, 65, 32, 84, 72, 82, 69, 69, 34))) == Set(Translated(List(34, 69, 76, 76, 79, 72, 65, 89, 33, 32, 69, 88, 84, 82, 65, 65, 89, 32, 69, 69, 84, 72, 82, 65, 89, 34))))
  run case19Test = assert(outcomes(TextInput(List(113, 117, 101, 101, 110, 32, 115, 113, 117, 101, 97, 108))) == Set(Translated(List(101, 101, 110, 113, 117, 97, 121, 32, 101, 97, 108, 115, 113, 117, 97, 121))))
  run case20Test = assert(outcomes(TextInput(List(104, 101, 108, 108, 111, 32, 49, 50, 51))) == Set(Translated(List(101, 108, 108, 111, 104, 97, 121, 32, 49, 50, 51))))
  run case21Test = assert(outcomes(TextInput(List(104, 101, 108, 108, 111, 44, 119, 111, 114, 108, 100))) == Set(Translated(List(101, 108, 108, 111, 104, 97, 121, 44, 111, 114, 108, 100, 119, 97, 121))))
  run case22Test = assert(outcomes(TextInput(List(49, 44, 50))) == Set(Translated(List(49, 44, 50))))
  run case23Test = assert(outcomes(TextInput(List(113, 33, 117, 101, 101, 110))) == Set(Translated(List(113, 97, 121, 33, 117, 101, 101, 110, 97, 121))))
  run case24Test = assert(outcomes(TextInput(List(34, 104, 101, 108, 108, 111, 34, 34, 87, 111, 114, 108, 100, 34))) == Set(Translated(List(34, 101, 108, 108, 111, 104, 97, 121, 34, 34, 79, 114, 108, 100, 119, 97, 121, 34))))
  run case25Test = assert(outcomes(TextInput(List(34, 81, 85, 69, 69, 78, 63, 33, 34))) == Set(Translated(List(34, 69, 69, 78, 81, 85, 65, 89, 63, 33, 34))))
  run case26Test = assert(outcomes(TextInput(List(81, 117, 101, 101, 110, 33, 33))) == Set(Translated(List(69, 101, 110, 113, 117, 97, 121, 33, 33))))
